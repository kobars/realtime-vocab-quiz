# AI-ASSISTED: example environment; copy to .env and adjust.
# The development Redis that `make up` starts (127.0.0.1:6381, no password, local only).
# The tests never use it: each run starts its own Redis, or uses REDIS_URL when CI sets it,
# and they refuse a REDIS_URL on port 6381.
REDIS_URL=redis://127.0.0.1:6381/0

# API settings (api/src/quiz/config.py). Every value below is the default; uncomment to change.
# STORE=memory                       # memory (one process) or redis (several nodes)
# NODE_ID=                           # default: <hostname>-<pid>
# QUIZ_PORT=8080                     # the public port; the default allowed origins use it
# ALLOWED_ORIGINS=                   # comma-separated; default: http://localhost and http://127.0.0.1 on QUIZ_PORT
# PER_IP_CONN_CAP=50                 # raise it for the demo and the load runs
# MAX_CONNECTIONS=10000              # per process
# TRUSTED_PROXIES=172.16.0.0/12      # comma-separated; X-Forwarded-For is trusted only from these
# TICK_MS=200
# TOP_N=50
# FULL_LIST_MAX=200
# MAX_PAYLOAD_BYTES=16384
# HEARTBEAT_MS=25000
# SEND_BUFFER_SOFT_BYTES=65536
# SEND_BUFFER_HARD_BYTES=262144
# GRACE_MS=10000
# RATE_LIMIT_PER_S=20
# RATE_LIMIT_BURST=40
# ADMIN_MOCK=0                       # 1 enables the mock quiz admin endpoints; needs ADMIN_TOKEN
# ADMIN_TOKEN=
