# AI-ASSISTED: example environment for the API, the development Redis and the full stack.
# The API reads process environment variables only; it never loads a .env file. Export these
# in the shell that starts the API (or let compose pass them to the API service).

# The development Redis that `make up` starts (127.0.0.1:6381, no password, local only).
# The tests never use it: each run starts its own Redis, or uses REDIS_URL when CI sets it,
# and they refuse a REDIS_URL on port 6381.
REDIS_URL=redis://127.0.0.1:6381/0

# API settings, read from the environment: api/src/quiz/config.py lists every one with its
# default. The common ones:
# STORE=memory              # memory (one process) or redis (several nodes); the API image
#                           # defaults to redis, the source (make dev-api) to memory
# REDIS_MAX_CONNECTIONS=100 # per pool: commands and quiz subscriptions (one per served quiz)
#                           # each have a pool of this size
# REDIS_POOL_TIMEOUT_MS=2000 # the wait for a free pooled connection when every one is busy
# REDIS_SOCKET_TIMEOUT_MS=5000 # a Redis command unanswered this long fails as UNAVAILABLE
#                           # (HTTP 503); above the host end's 2 s WAITAOF, below nginx's 60 s
# REDIS_CONNECT_TIMEOUT_MS=2000 # the same bound for opening a connection to Redis
# ALLOWED_ORIGINS=          # comma-separated; the WebSocket upgrade from any other origin gets 403
# PER_IP_CONN_CAP=50        # raise it for the load runs; make demo raises it when it is unset
# TRUSTED_PROXIES=127.0.0.1/32,::1/128  # peers whose X-Forwarded-For names the client: set
#                           # it to nginx's address or its compose network's subnet
# ADMIN_MOCK=0              # 1 enables the mock quiz admin endpoints; needs a non-blank ADMIN_TOKEN
# PUBLIC_HOSTING=1          # 0 removes self-service hosting (POST /quizzes and its end)
# HOSTING_MAX_OPEN=50       # open self-hosted quizzes, all nodes; above it HTTP 503 HOSTING_FULL
# HOSTING_PER_IP=5          # quizzes one client address may host per HOSTING_PER_IP_WINDOW_S
# HOSTING_PER_IP_WINDOW_S=600 # (600 s); above it HTTP 429 RATE_LIMITED

# The full stack (docker compose --profile full) reads these from .env. Compose refuses to run
# until both secrets are set: the mock admin token of both API nodes and the stack Redis password.
# Generate each with `openssl rand -hex 24`; the password goes into a URL. (A comment after an
# empty value would become the value.)
ADMIN_TOKEN=
REDIS_PASSWORD=
QUIZ_PORT=8080              # nginx on 127.0.0.1; the API's default allowed origins use it
# IMAGE_TAG=dev             # the tag of `make build` to run
# REDIS_MAXMEMORY=256mb     # the stack Redis's memory cap; when full it refuses writes and
#                           # evicts nothing. A player who answered all 10 questions of a
#                           # quiz holds about 2 KB, so 256mb keeps about 100,000 players
# QUIZ_SUBNET=10.89.78.0/24 # the stack network, trusted for X-Forwarded-For; move it on overlap
