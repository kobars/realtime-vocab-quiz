# AI-ASSISTED: the .env of the full stack on a public host behind HTTPS (make prod-up).
# Copy it to .env, set DOMAIN, and generate both secrets (docs/operations.md, "Deploy to a VM").
# (A comment after an empty value would become the value.)

# Every `docker compose` call in this folder, the make targets' included, then runs the override
# too, so a target such as make demo or make down acts on the HTTPS stack as it is.
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# The host name whose DNS A record points at this machine; without a domain, <ip>.sslip.io
# (the machine's IPv4 address, dots kept) resolves to that address.
DOMAIN=quiz.example.com
# The only origin allowed to open the WebSocket (others get HTTP 403).
ALLOWED_ORIGINS=https://${DOMAIN}

# Generate each with `openssl rand -hex 24`. ADMIN_TOKEN is the only guard of the mock admin
# API, which creates and ends quizzes: keep it secret.
ADMIN_TOKEN=
REDIS_PASSWORD=

# Each player has an address of their own here: the default cap applies.
PER_IP_CONN_CAP=50
# The stack Redis's memory cap; when full it refuses writes and evicts nothing. A player who
# answered all 10 questions holds about 2 KB, so 1gb keeps about 400,000 players.
REDIS_MAXMEMORY=1gb

# TLS_ISSUER=acme           # acme: a Let's Encrypt certificate; internal: Caddy's local CA
# EDGE_SUBNET=10.89.79.0/24 # Caddy and nginx's network; move it, or QUIZ_SUBNET, on overlap
